# Kalshi API auth
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# KALSHI_PRIVATE_KEY=
KALSHI_SHADOW_API_KEY_ID=
KALSHI_SHADOW_PRIVATE_KEY_PATH=


# Defaults to paper/demo. Set explicitly if needed.
KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

# Hosted database (future hosted mode). Leave blank for local SQLite until the
# Postgres/Supabase Store implementation is added.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2.75 production-shadow market data. This is read-only; no production orders are submitted.
KALSHI_SHADOW_BASE_URL=https://external-api.kalshi.com/trade-api/v2
# Production read-only credentials for shadow tracking (set above under "Kalshi API auth").
# The production/external API rejects demo keys, so these must be a real production API
# key/key-file; they fall back to the primary KALSHI_API_KEY_ID / KALSHI_PRIVATE_KEY_PATH
# if left blank. Optionally inline the PEM instead of a path:
# KALSHI_SHADOW_PRIVATE_KEY=

# Scanner config. With KALSHI_SERIES_TICKERS set, KALSHI_MARKET_LIMIT is per series.
KALSHI_MARKET_LIMIT=50
KALSHI_SERIES_TICKERS=KXTEMPNYCH,KXTEMPCHIH,KXTEMPBOSH,KXTEMPDCH,KXTEMPLAXH,KXTEMPMIAH,KXHIGHAUS,KXHIGHCHI,KXHIGHDEN,KXHIGHHOU,KXPHILHIGH,KXHIGHTSEA,KXHIGHTSFO,KXHIGHNY,KXHIGHMIA,KXLOWTAUS,KXLOWTCHI,KXLOWTBOS,KXLOWNYC,KXLOWLAX,KXRAINAUSM,KXRAINCHIM,KXRAINDALM,KXRAINHOUM,KXRAINLAXM,KXRAINMIAM,KXRAINNYC
MIN_EDGE_CENTS=3

# Forecast-quality risk controls (added 2026-05-28 after shadow losses; see PROJECT_STATUS.md).
# Place at most the single best fee-adjusted-EV order per event (one city/date/hour ladder).
# Strikes in an event are ~perfectly correlated, so stacking bets turns one wrong forecast into
# many simultaneous losses. This was the dominant driver of the first shadow losses.
BEST_STRIKE_PER_EVENT=true
# Skip temperature markets when forecast sigma >= ratio * strike spacing (the forecast cannot
# resolve adjacent strikes). 1.0 means "skip when sigma >= spacing". With the recalibrated sigma
# this skips KXTEMPNYCH hourly entirely (the honest "no edge" outcome); raise it to keep trading
# and collecting shadow-fill data on markets the model cannot really call.
FORECAST_UNCERTAINTY_GATE_RATIO=1.0
# Assumed degrees-F spacing between one-sided -T ladder strikes (bands use their own width).
DEFAULT_STRIKE_SPACING_F=1.0

# Bounded SHADOW-ONLY data-collection experiment (added 2026-05-30; see PROJECT_STATUS.md).
# The conservative FORECAST_UNCERTAINTY_GATE_RATIO above blocks every 1F temperature ladder, so
# the read-only shadow tracker records ~no settled temperature fills and the model can never
# gather data to recalibrate sigma. These relax the gate FOR SHADOW ONLY (paper/demo stay at the
# conservative ratio above) until the date below, then auto-revert. The other forecast-quality
# controls (MIN_TRADE_PROBABILITY, EV gate, BEST_STRIKE_PER_EVENT, per-event caps) stay in force.
# Set SHADOW_GATE_EXPERIMENT_UNTIL empty to disable the experiment immediately.
SHADOW_FORECAST_UNCERTAINTY_GATE_RATIO=6.0
SHADOW_GATE_EXPERIMENT_UNTIL=2026-06-06

# Model-quality controls from the 2026-06-08 shadow review. These only use settled ledger
# evidence; they do not enable live trading. Bias correction is sample-gated and clipped.
ENABLE_FORECAST_BIAS_CORRECTION=true
FORECAST_BIAS_MIN_SAMPLES=3
FORECAST_BIAS_LOOKBACK_DAYS=45
FORECAST_BIAS_MAX_ADJUSTMENT_F=6.0
FORECAST_BIAS_SOURCE=both
FORECAST_BIAS_INCLUDE_LOOKAHEAD=false
ENABLE_DYNAMIC_SIGMA=true
DYNAMIC_SIGMA_MIN_SAMPLES=5
DYNAMIC_SIGMA_MULTIPLIER=1.75
DYNAMIC_SIGMA_MAX_F=14.0
DYNAMIC_SIGMA_SOURCE=both
DYNAMIC_SIGMA_INCLUDE_LOOKAHEAD=false
STALE_UNSETTLED_GRACE_HOURS=6
# Counterfactual settlement backfill: resolve outcomes for skipped markets (read-only get_market
# calls) so bias correction / dynamic sigma can calibrate even while the uncertainty gate blocks
# all temperature fills. Gated temperature rows qualify regardless of EV; other skip reasons need
# the EV floor below.
COUNTERFACTUAL_BACKFILL_ENABLED=true
COUNTERFACTUAL_MAX_FETCHES_PER_RUN=25
COUNTERFACTUAL_MIN_EV_CENTS=10
# Bulky raw production orderbook payloads are off by default to fit the free Supabase tier.
# Enable only for short debugging windows.
PERSIST_SHADOW_ORDERBOOK_JSON=false

# Phase 2.5 safety limits, moderately aggressive demo settings
MAX_ORDERS_PER_DAY=20
MAX_CONTRACTS_PER_MARKET=3
# Event-level caps treat one city/day/hour's correlated strike ladder as a single risk.
# Keep this at 1 until shadow calibration proves that multiple strikes in the same event add value.
MAX_CONTRACTS_PER_EVENT=1
DISALLOW_MULTIPLE_POSITIONS_PER_EVENT=true
MAX_EVENT_EXPOSURE_CENTS=1500
MAX_TOTAL_EXPOSURE_CENTS=5000
ORDER_COOLDOWN_MINUTES=240
DISALLOW_OPPOSITE_SIDE_SAME_MARKET=true
# Avoid turning noisy forecast tails into a low-win-rate stream of 1c/4c longshots.
MIN_TRADE_PROBABILITY=0.55
MIN_YES_ASK_CENTS=1
MAX_YES_ASK_CENTS=97
MIN_NO_ASK_CENTS=1
MAX_NO_ASK_CENTS=97
# Adjacent-hour same-side cap for hourly temperature markets. This stops one diurnal/source-bias
# regime from creating repeated same-direction losses across nearby hours.
MAX_SAME_DAY_DIRECTIONAL_ORDERS=2
MAX_ADJACENT_HOUR_DIRECTIONAL_ORDERS=1
ADJACENT_HOUR_WINDOW=3

# Expensive BUY_NO guard. Rain and narrow bucket NO trades can risk 60-95c to make pennies;
# require a larger EV cushion and cap extreme NO asks by variable/shape.
EXPENSIVE_NO_ASK_CENTS=60
EXPENSIVE_NO_MIN_FEE_ADJUSTED_EV_CENTS=15
MAX_ASYMMETRIC_NO_ASK_CENTS=90
MAX_RAIN_NO_ASK_CENTS=65
MAX_BAND_NO_ASK_CENTS=65

# Optional override. If blank, MIN_EDGE_CENTS * quantity is used.
# MIN_FEE_ADJUSTED_EV_CENTS=3
